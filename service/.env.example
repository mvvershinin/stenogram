# Скопировать в service/.env (не коммитится, см. .gitignore) и заполнить.
#
#   cp .env.example .env

# S3-хранилище: подходит любое S3-совместимое. Бакет должен существовать заранее, локальный
# MinIO создаёт его сам.
#
# Вариант 1: локальный MinIO из docker-compose.minio.yml.
COMPOSE_FILE=docker-compose.yml:docker-compose.minio.yml
STENOGRAM_S3_ENDPOINT=minio:9000
STENOGRAM_S3_SECURE=false
STENOGRAM_S3_ACCESS_KEY=stenogram
#
# CHANGE — намеренно короче 8 символов: MinIO требует пароль не короче 8 (проверено — при
# более коротком падает с понятным FATAL при старте и не поднимается), так что
# скопированный «как есть» .env не даст стенду тихо взлететь на угадываемом пароле.
STENOGRAM_S3_SECRET_KEY=CHANGE
#
# Вариант 2: своё хранилище. MinIO не запускается, его образы не нужны. Воркер при этом
# получает выход в сеть: иначе до внешнего адреса ему не дойти.
#
# COMPOSE_FILE=docker-compose.yml
# STENOGRAM_S3_ENDPOINT=s3.example.com
# STENOGRAM_S3_SECURE=true
# STENOGRAM_S3_REGION=us-east-1
# STENOGRAM_S3_ACCESS_KEY=...
# STENOGRAM_S3_SECRET_KEY=...

# Бакет кэша и результатов.
STENOGRAM_S3_BUCKET=stenogram

# Каталоги моделей НА ХОСТЕ — абсолютные пути, без ~ (docker compose тильду не
# разворачивает). Подготовка — service/README.md, раздел «Подготовка моделей»:
#   python -m stenogram.models --fetch
# либо уже существующий кэш:
STENOGRAM_MODELS_DIR=/home/USER/.cache/stenogram
STENOGRAM_WHISPER_MODELS_DIR=/home/USER/.cache/huggingface/hub

# Модель распознавания. large-v3-turbo — умолчание пакета; для быстрой проверки
# на CPU без карты берите small или tiny (см. service/README.md).
STENOGRAM_WHISPER_MODEL=large-v3-turbo

# Порт API на хосте.
STENOGRAM_API_PORT=8000
