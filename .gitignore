# Окружение — разворачивается через ./setup.sh, весит больше гигабайта
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Модели — скачиваются при установке, в репозитории им не место
models/
*.onnx
*.bin
*.ct2
*.tar.bz2

# Исходные записи: могут содержать персональные данные и весят сотни мегабайт
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.mp3
*.m4a
*.wav
*.ogg
*.flac
*.opus

# Результаты обработки
*.srt
*.vtt
/out/
/output/
/результаты/
/заседание_*/

# Синтетические фикстуры тестов — исключение из правил выше.
# Правила против записей и моделей писались против корня, но бьют по всему дереву:
# без этих строк tests/fixtures/*.wav, *.srt, *.vtt, *.bin молча не попадут в коммит.
!tests/fixtures/
!tests/fixtures/**

# ОС и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Локальные настройки Claude Code (разрешения конкретной машины)
.claude/settings.local.json

# Сервис: секреты и локальные пути к моделям на конкретной машине
service/.env
.env
